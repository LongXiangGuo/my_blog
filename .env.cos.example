# =========================================================================
# 腾讯云 COS 部署配置模板
# 用法：复制本文件为 .env.cos，然后填入真实值（.env.cos 已加入 .gitignore，不会被提交）
#   cp .env.cos.example .env.cos
# =========================================================================

# ── API 密钥（前往 https://console.cloud.tencent.com/cam/capi 获取）──
# 建议使用子账号密钥，仅授予该存储桶的读写权限，更安全
SECRET_ID=your-secret-id
SECRET_KEY=your-secret-key

# ── 存储桶与地域（创建后不可修改）──
BUCKET=docs-1462935598
REGION=ap-shanghai

# ── 本地构建产物目录（一般不用改）──
DIST_DIR=.vitepress/dist

# ── 部署到桶的哪个前缀 ──
# 根目录：留空（访问地址 https://docs-1462935598.cos.ap-shanghai.myqcloud.com/）
# 子目录：填 "blog/"（访问地址 .../blog/，并需同步修改 .vitepress/config.mts 的 base）
KEY_PREFIX=blog/